# Credentials ---
RABBITMQ_DEFAULT_USER=sysadmin
RABBITMQ_DEFAULT_PASS=sysadmin@@123
 
# Default vhost
RABBITMQ_DEFAULT_VHOST=/
 
# Networking / identity
RABBITMQ_NODENAME=rabbit@rabbitmq
HOSTNAME=rabbitmq
 
# Host ports (left-hand side of the compose port mappings)
RABBITMQ_AMQP_PORT=5672
RABBITMQ_AMQPS_PORT=5671
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DIST_PORT=25672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_MQTT_PORT=1883
