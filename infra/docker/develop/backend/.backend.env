# Database related settings
DATABASE_URL=postgresql://dbadmin:dbadmin%40%402026@postgres:5001/luxus_connect_dev
CONNECTION_STRING=postgresql://dbadmin:dbadmin%40%402026@postgres:5001/luxus_connect_dev

# Application server related settings
ENVIRONMENT=Development
MONITORING_TEST_ENABLED=false

# Railway related settings
RAILWAY_PUBLIC_DOMAIN=

# Message broker related settings
RABBITMQ_URL=amqp://sysadmin:sysdamin%40%40123@mabbit:5672

# Authentication and identity server related settings
KEYCLOAK_URL=http://keycloak:8081
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8081
KEYCLOAK_PUBLIC_AUTH_SERVER_URL=http://keycloak:8081
KEYCLOAK_RESOURCE=
KEYCLOAK_ADMIN_USERNAME=sysadmin
KEYCLOAK_ADMIN_PASSWORD=sysadmin@@123

# Storage bucket related settings
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_SERVICE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# SMTP server related settings
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=

# Sicredi API de Cobrança — Luxus Telefonia Ltda - Portal: https://developer.sicredi.com.br
SICREDI_ENABLED=true
SICREDI_SANDBOX=true
# x-api-key do portal (Sandbox ou Produção — nunca misturar)
SICREDI_API_KEY=
# Código de acesso gerado no Internet Banking → Cobrança → Código de Acesso
SICREDI_PASSWORD=
# Username OAuth: beneficiário + cooperativa (ex.: 010480179)
# Se vazio, monta automaticamente: SICREDI_CODIGO_BENEFICIARIO + SICREDI_COOPERATIVA
SICREDI_USERNAME=010480179
# Convênio Luxus
SICREDI_COOPERATIVA=0179
SICREDI_POSTO=14
SICREDI_CODIGO_BENEFICIARIO=01048
# URL pública da API (para registrar webhook no Sicredi)
# Ex.: https://api.suaempresa.com.br
SICREDI_PUBLIC_API_URL=
# Token que o Sicredi enviará no header Authorization do webhook
SICREDI_WEBHOOK_TOKEN=
# Registra webhook automaticamente ao iniciar a API (produção)
SICREDI_AUTO_REGISTER_WEBHOOK=false
